# Copy this file to .env.local and set all three values. Never commit .env.local.
# Create a sending API key in your Resend account.
RESEND_API_KEY=
# Use a sender on a domain you have verified in Resend.
# Example: "Randeniya Lake Resort <reservations@your-verified-domain.com>"
RESERVATION_FROM_EMAIL=
# The inbox where the concierge should receive reservation inquiries.
RESERVATION_TO_EMAIL=

# Optional: published policy pages linked from the footer.
# Each link stays hidden until its URL is configured. Use complete HTTPS URLs.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
